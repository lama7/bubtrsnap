ALLOWED_GLOBAL_OPTIONS = {
    "snapshot_dir": str,
    "backup_dir": str,
    "sudo": bool,
    "snaps_only": bool,
    "send_to_dir": str,
    "receive_from_dir": str,    
    "keep_hourly": int,
    "keep_daily": int,
    "keep_weekly": int,
    "keep_monthly": int,
    "keep_yearly": int,
    "verbose": int,
    "dry_run": bool,
}

ALLOWED_ARCHIVE_OPTIONS = {
    "subvolume": str,
    "snaps_only": bool,
    "send_to_file": str,
    "receive_from_file": str,
    "pre_snapshot_hook": str,
    "post_snapshot_hook": str,
    "post_backup_hook": str,
    "keep_hourly": int,
    "keep_daily": int,
    "keep_weekly": int,
    "keep_monthly": int,
    "keep_yearly": int,
}

def _check_type(name: str, value: Any, expected_type: type, context: str) -> None:
    """Helper to check a single value's type."""
    if expected_type is str:
        if not isinstance(value, str):
            print(f"Error: '{name}' in {context} must be a string, got {type(value).__name__}",
                  file=sys.stderr)
            sys.exit(1)
    elif expected_type is int:
        if not isinstance(value, int) or isinstance(value, bool):  # bool is subclass of int
            print(f"Error: '{name}' in {context} must be an integer, got {type(value).__name__}",
                  file=sys.stderr)
            sys.exit(1)
    elif expected_type is bool:
        if not isinstance(value, bool):
            print(f"Error: '{name}' in {context} must be a boolean (true/false), got {type(value).__name__}",
                  file=sys.stderr)
            sys.exit(1)

def validate_config(file_cfg: dict) -> None:
    """
    Validate that the loaded TOML only contains known options
    and that their types are correct.
    """
    for key, value in file_cfg.items():
        if isinstance(value, dict) and "subvolume" in value:
            # ----- Archive section -----
            archive_name = key
            context = f"archive section [{archive_name}]"

            for opt, opt_value in value.items():
                if opt not in ALLOWED_ARCHIVE_OPTIONS:
                    print(f"Error: unknown option '{opt}' in {context}", file=sys.stderr)
                    sys.exit(1)
                _check_type(opt, opt_value, ALLOWED_ARCHIVE_OPTIONS[opt], context)

            # Extra sanity: subvolume should not be empty
            v = value.get("subvolume", "")
            if not v.strip():
                print(f"Error: 'subvolume' in {context} cannot be empty", file=sys.stderr)
                sys.exit(1)

        else:
            # ----- Global option -----
            if key not in ALLOWED_GLOBAL_OPTIONS:
                print(f"Error: unknown global option '{key}' in configuration file",
                      file=sys.stderr)
                sys.exit(1)
            _check_type(key, value, ALLOWED_GLOBAL_OPTIONS[key], "global configuration")


def load_toml(path: Path) -> dict[str, Any]:
    with path.open("rb") as f:
        return tomllib.load(f)

def resolve_keep_policy(archive_cfg: dict, global_cfg: dict, cli_keeps: dict) -> dict:
    """
    Resolve the effective keep policy for an archive.
    
    Priority:
    1. CLI keeps (if any were specified) → missing ones become 0
    2. Archive-specific keeps → missing ones become 0
    3. Global keeps
    """
    keep_keys = ["keep_hourly", "keep_daily", "keep_weekly", "keep_monthly", "keep_yearly"]

    # 1. CLI takes full control if any keep was given
    if cli_keeps:
        policy = {k: 0 for k in keep_keys}
        policy.update(cli_keeps)
        return policy

    # 2. Archive-specific keeps (complete override)
    archive_has_keeps = any(k in archive_cfg for k in keep_keys)
    if archive_has_keeps:
        policy = {k: 0 for k in keep_keys}
        for k in keep_keys:
            if k in archive_cfg:
                policy[k] = archive_cfg[k]
        return policy

    # 3. Fall back to global
    return {k: global_cfg.get(k, 0) for k in keep_keys}

def parse_cli_archives(raw_args: list[str]) -> dict[str, str | None]:
    """
    Parse CLI archive arguments.
    
    Returns:
        dict of {archive_name: subvolume_path_or_None}
        
    Examples:
        "home"              → {"home": None}
        "home=/home"        → {"home": "/home"}
        "home maildir=/mail"→ {"home": None, "maildir": "/mail"}
    """
    result = {}
    for item in raw_args:
        if "=" in item:
            name, path = item.split("=", 1)
            if not name:
                print(f"Invalid archive specification: {item}", file=sys.stderr)
                sys.exit(1)
            result[name] = path
        else:
            if not item:
                print("Invalid empty archive name", file=sys.stderr)
                sys.exit(1)
            result[item] = None
    return result

# ---------------------------------------------------------------------------
# Main entry to setup archives for processing
# ---------------------------------------------------------------------------
def load_and_resolve_archives(cli: argparse.Namespace, config_path: Path | None) -> tuple[dict, list[dict]]:
    global_cfg = DEFAULT_CONFIG.copy()
    raw_archives = {}  # name -> raw section from TOML

    # Load TOML
    if config_path and config_path.exists():
        try:
            file_cfg = load_toml(config_path)
        except Exception as e:
            print(f"Error in config file {config_path}: {e}", file=sys.stderr)
            sys.exit(1)

        validate_config(file_cfg)

        for key, value in file_cfg.items():
            if isinstance(value, dict) and "subvolume" in value:
                raw_archives[key] = value
            else:
                global_cfg[key] = value

    # expand directory paths for paths specified like "~/"
    if "send_to_dir" in global_cfg and global_cfg["send_to_dir"]:
        global_cfg["send_to_dir"] = expand_path(global_cfg["send_to_dir"])
    if "receive_from_dir" in global_cfg and global_cfg["receive_from_dir"]:
        global_cfg["receive_from_dir"] = expand_path(global_cfg["receive_from_dir"])

    # Apply global CLI overrides
    if cli.snapshot_dir:
        global_cfg["snapshot_dir"] = cli.snapshot_dir
    if cli.backup_dir:
        global_cfg["backup_dir"] = cli.backup_dir
    if cli.sudo:
        global_cfg["sudo"] = True
    if getattr(cli, "snaps_only", False):
        global_cfg["snaps_only"] = True

    # Global CLI overrides (dirs only; file options are archive-specific)
    if getattr(cli, "send_to_dir", None):
        cli.send_to_dir = expand_path(cli.send_to_dir)
        chk_is_dir(cli.send_to_dir, "send-to-dir")
        global_cfg["send_to_dir"] = cli.send_to_dir
    if getattr(cli, "receive_from_dir", None):
        cli.receive_from_dir = expand_path(cli.receive_from_dir)
        chk_is_dir(cli.receive_from_dir, "receive-from-dir")
        global_cfg["receive_from_dir"] = cli.receive_from_dir

    cli_send_file = getattr(cli, "send_to_file", None)
    if cli_send_file:
        cli_send_file = expand_path(cli_send_file)
    cli_recv_file = getattr(cli, "receive_from_file", None)
    if cli_recv_file:
        cli_recv_file = expand_path(cli_recv_file)

    # CLI keep options
    cli_keeps = {}
    for key in ("keep_hourly", "keep_daily", "keep_weekly", "keep_monthly", "keep_yearly"):
        val = getattr(cli, key, None)
        if val is not None:
            cli_keeps[key] = val

    # Parse CLI archives (new style)
    cli_archives = parse_cli_archives(cli.archives) if cli.archives else {}

    # File options on CLI require exactly one archive
    if cli_send_file or cli_recv_file:
        n_cli = len(cli_archives) if cli_archives else 0
        n_cfg = len(raw_archives)
        if n_cli > 1:
            print("Error: --send-to-file/--receive-from-file require exactly one archive",
                  file=sys.stderr)
            sys.exit(1)
        if n_cli == 0 and n_cfg != 1:
            print("Error: --send-to-file/--receive-from-file with no CLI archive "
                  "require exactly one archive in the configuration file",
                  file=sys.stderr)
            sys.exit(1)
        if cli_send_file and cli_recv_file and cli_send_file != cli_recv_file:
            print("Error: --send-to-file and --receive-from-file must name the same file",
                  file=sys.stderr)
            sys.exit(1)

    archives_to_process = []

    if cli_archives:
        # Only process archives listed on the CLI
        for name, cli_subvol in cli_archives.items():
            raw = raw_archives.get(name, {})

            if cli_subvol is None:
                # No subvolume given on CLI → must exist in config
                if name not in raw_archives:
                    print(f"Error: archive '{name}' not found in configuration and no subvolume specified.",
                          file=sys.stderr)
                    sys.exit(1)
                subvol = raw.get("subvolume")
            else:
                # Explicit subvolume on CLI wins
                subvol = cli_subvol

            if not subvol:
                print(f"Error: archive '{name}' has no subvolume defined.", file=sys.stderr)
                sys.exit(1)

            archive_cfg = {
                "name": name,
                "subvolume": subvol,
                **raw,
            }
            # Ensure CLI subvolume takes precedence
            archive_cfg["subvolume"] = subvol
            archives_to_process.append(archive_cfg)
    else:
        # No archives on CLI → process all from config
        for name, raw in raw_archives.items():
            archive_cfg = {"name": name, **raw}
            archives_to_process.append(archive_cfg)

    # Resolve final settings for each archive
    resolved = []
    for raw in archives_to_process:
        name = raw["name"]
        subvol = raw.get("subvolume")

        if not subvol:
            print(f"Error: archive '{name}' has no subvolume defined.", file=sys.stderr)
            sys.exit(1)

        subvol_path = Path(subvol)
        if not subvol_path.exists():
            print(f"Error: subvolume path does not exist: {subvol}", file=sys.stderr)
            sys.exit(1)

        # Per-archive file options: CLI overrides archive section; never global
        send_file = cli_send_file if cli_send_file is not None else raw.get("send_to_file")
        recv_file = cli_recv_file if cli_recv_file is not None else raw.get("receive_from_file")
        if send_file and recv_file and send_file != recv_file:
            print(f"Error in archive {name}: send_to_file and receive_from_file "
                  f"must be the same file", file=sys.stderr)
            sys.exit(1)
        if send_file:
            send_file = expand_path(send_file)
        if recv_file:
            recv_file = expand_path(recv_file)

        # Dir options from global (CLI already folded into global_cfg)
        send_dir = global_cfg.get("send_to_dir")
        recv_dir = global_cfg.get("receive_from_dir")

        # Hard error: mixing file options with dir options
        if (send_file or recv_file) and (send_dir or recv_dir):
            print(f"Error: cannot mix send-to-file/receive-from-file with "
                  f"send-to-dir/receive-from-dir (archive '{name}')",
                  file=sys.stderr)
            sys.exit(1)

        snaps_only = True if getattr(cli, "snaps_only", False) \
                     else raw.get("snaps_only", global_cfg.get("snaps_only", False))

        if snaps_only and (send_file or recv_file or send_dir or recv_dir):
            print(f"Error in archive {name}: snaps_only is mutually exclusive "
                  f"with send/receive file and directory options",
                  file=sys.stderr)
            sys.exit(1)

        entry = {
            "name": name,
            "subvolume": str(subvol_path),
            "snaps_only": snaps_only,
            "send_to_file": send_file,
            "receive_from_file": recv_file,
            "send_to_dir": None if (send_file or recv_file) else send_dir,
            "receive_from_dir": None if (send_file or recv_file) else recv_dir,
            "pre_snapshot_hook": raw.get("pre_snapshot_hook"),
            "post_snapshot_hook": raw.get("post_snapshot_hook"),
            "post_backup_hook": raw.get("post_backup_hook"),
            "keep": resolve_keep_policy(raw, global_cfg, cli_keeps),
        }
        resolved.append(entry)

    return global_cfg, resolved

# ---------------------------------------------------------------------------
# Functions that use btrfs commands
# ---------------------------------------------------------------------------
def btrfs_cmd(cfg: dict, *args: str) -> list[str]:
    cmd = ["btrfs"]
    if cfg.get("sudo"):
        cmd = ["sudo", "-n"] + cmd
    return cmd + list(args)

# makes sure the dir is a subvolume, errors out if not
def chk_btrfs_subvolume(dir: Path, cfg: dict):
    try:
        run(btrfs_cmd(cfg, "subvolume", "show", str(dir)),
            dry_run=False,
            verbosity=cfg["verbose"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True)
        log(f"\t{dir} is a valid btrfs subvolume", 2, cfg["verbose"])
                                    
    except subprocess.CalledProcessError:
        print(f"Error: '{dir}' is not a btrfs subvolume "
        f"(required for snapshot/backup/receive operations)", file=sys.stderr)
        sys.exit(1)

def create_snapshot(archive: str, subvol: str, snap_dir: Path, cfg: dict) -> Path:
    name = f"{archive}.{timestamp()}"
    dest = snap_dir / name
    cmd = btrfs_cmd(cfg, "subvolume", "snapshot", "-r", subvol, str(dest))
    try:
        run(cmd, 
            dry_run=cfg.get("dry_run", False),
            verbosity=cfg["verbose"],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        print(f"Error executing `{cmd}`")
        sys.exit(1)

    return dest

def get_subvol_uuids(path: Path, cfg: dict) -> tuple[str | None, str | None]:
    """
    Returns (UUID, Received UUID) for a btrfs subvolume.
    Returns (None, None) on failure.
    """
    try:
        result = run(btrfs_cmd(cfg, "subvolume", "show", str(path)),
                     dry_run=False, # this allows code to be executed properly during a dry-run
                     verbosity=cfg["verbose"],
                     check=True,  
                     capture_output=True, 
                     text=True)
        uuid = None
        received_uuid = None
        for line in result.stdout.splitlines():
            line = line.strip()
            if line.startswith("UUID:"):
                uuid = line.split(":", 1)[1].strip()
            elif line.startswith("Received UUID:"):
                val = line.split(":", 1)[1].strip()
                received_uuid = None if val == "-" else val

        # Debug level only
        log(f"{path}: UUID={uuid}  Received UUID={received_uuid}", 3, cfg["verbose"])
        return uuid, received_uuid
    except subprocess.CalledExceptionError:
        log(f"Failed to get UUIDs for {path}", 3, cfg["verbose"])
        return None, None

def find_parents(archive: str, snapshot_dir: Path, backup_dir: Path, cfg: dict) -> list[Path]:
    """
    Find previous snapshots in snapshot_dir that have already been
    successfully received to backup_dir (matched by UUID ↔ Received UUID).
    Returns them newest-first.
    """
    log(f"Finding parent subvolumes for {archive}", 2, cfg["verbose"])
    # Collect snapshots
    snapshots = []
    for p in snapshot_dir.glob(f"{archive}.*"):
        if not p.is_dir():
            continue
        uuid, _ = get_subvol_uuids(p, cfg)
        if uuid:
            ts = parse_ts(p.name)
            if ts:
                snapshots.append((ts, p, uuid))

    # Collect received UUIDs from backup side
    received_uuids = set()
    for p in backup_dir.glob(f"{archive}.*"):
        if not p.is_dir():
            continue
        _, received_uuid = get_subvol_uuids(p, cfg)
        if received_uuid:
            received_uuids.add(received_uuid)

    # Match
    parents = []
    for ts, path, uuid in snapshots:
        if uuid in received_uuids:
            parents.append((ts, path))
            log(f"Usable parent: {path.name}", 3, cfg["verbose"])

    parents.sort(key=lambda x: x[0], reverse=True)
    result = [path for _, path in parents]

    if result:
        log(f"Found {len(result)} usable parent(s) for {archive}", 3, cfg["verbose"])
    else:
        log("No usable parents found", 3, cfg["verbose"])

    return result

def send_backup(snap: Path, snapshot_dir: Path, backup_dir: Path, cfg: dict, archive: str) -> Path:
    parents = find_parents(archive, snapshot_dir, backup_dir, cfg)

    send_cmd = btrfs_cmd(cfg, "send")

    if not parents:
        log("Full send (no matching parent found)", 1, cfg["verbose"])
    elif len(parents) == 1:
        log(f"Incremental send using parent {parents[0].name}", 1, cfg["verbose"])
        send_cmd += ["-p", str(parents[0])]
    else:
        log(f"Incremental send using {len(parents)} clone sources", 1, cfg["verbose"])
        for p in parents:
            send_cmd += ["-c", str(p)]

    send_cmd.append(str(snap))
    dest = backup_dir / snap.name

    if cfg.get("dry_run"):
        log(f"[dry-run] {' '.join(send_cmd)} | btrfs receive {backup_dir}", 2, cfg["verbose"])
        return dest

    recv_cmd = btrfs_cmd(cfg, "receive", str(backup_dir))

    # Level 2 shows the actual command
    log(f"{' '.join(send_cmd)} | {' '.join(recv_cmd)}", 2, cfg["verbose"])

    start_time = datetime.now()

    send_proc = subprocess.Popen(send_cmd,
                                 stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL)
    recv_proc = subprocess.Popen(recv_cmd, 
                                 stdin=send_proc.stdout,
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
    send_proc.stdout.close()
    recv_proc.communicate()

    elapsed = (datetime.now() - start_time).total_seconds()
    # Level 1 shows the timing summary
    log(f"btrfs send/receive completed in {format_duration(elapsed)}", 1, cfg["verbose"])

    if recv_proc.returncode != 0:
        raise RuntimeError("btrfs receive failed")

    return dest

def send_backup_tofile(snap: Path, snapshot_dir: Path, backup_dir: Path | None,
                       stream_file: Path, cfg: dict, archive: str) -> Path:
    """
    btrfs send -f <stream_file>.  Errors if stream_file already exists.
    """
    parents = find_parents(archive, snapshot_dir, backup_dir, cfg) if backup_dir else []

    send_cmd = btrfs_cmd(cfg, "send")
    if not parents:
        log("Full send to file (no matching parent found)", 1, cfg["verbose"])
    elif len(parents) == 1:
        log(f"Incremental send to file using parent {parents[0].name}", 1, cfg["verbose"])
        send_cmd += ["-p", str(parents[0])]
    else:
        log(f"Incremental send to file using {len(parents)} clone sources", 1, cfg["verbose"])
        for p in parents:
            send_cmd += ["-c", str(p)]

    if stream_file.exists():
        print(f"Error: stream file already exists: {stream_file}", file=sys.stderr)
        print("Delete it manually or choose a different path.", file=sys.stderr)
        sys.exit(1)

    send_cmd += ["-f", str(stream_file), str(snap)]

    if cfg.get("dry_run"):
        log(f"[dry-run] {' '.join(send_cmd)}", 2, cfg["verbose"])
        return stream_file

    log(f"{' '.join(send_cmd)}", 2, cfg["verbose"])
    start_time = datetime.now()
    try:
        run(send_cmd, dry_run=False, verbosity=cfg["verbose"],
            stderr=subprocess.DEVNULL, check=True)
    except subprocess.CalledProcessError:
        print(f"Error with `{' '.join(send_cmd)}`", file=sys.stderr)
        sys.exit(1)

    elapsed = (datetime.now() - start_time).total_seconds()
    log(f"btrfs send to file completed in {format_duration(elapsed)}", 1, cfg["verbose"])
    log(f"Stream file created: {stream_file}", 1, cfg["verbose"])
    return stream_file

def receive_stream(stream: Path, backup_dir: Path, cfg: dict) -> str | None:
    """
    Execute `btrfs receive -f <stream> <backup_dir>`.
    Returns the received subvolume basename on success, None on 'already exists'.
    Aborts the whole program on any other error.
    """
    recv_cmd = btrfs_cmd(cfg, "receive", "-f", str(stream), str(backup_dir))

    if cfg.get("dry_run"):
        log(f"[dry-run] {' '.join(recv_cmd)}", 2, cfg["verbose"])
        return stream.stem

    log(f"{' '.join(recv_cmd)}", 2, cfg["verbose"])
    start = datetime.now()

    result = subprocess.run(
        recv_cmd,
        capture_output=True,
        text=True,
        check=False,
    )

    elapsed = (datetime.now() - start).total_seconds()
    log(f"btrfs receive completed in {format_duration(elapsed)}", 1, cfg["verbose"])

    stderr = (result.stderr or "").strip()

    if result.returncode != 0:
        if "already exists" in stderr.lower():
            print(f"Warning: subvolume from '{stream.name}' already exists in "
                  f"{backup_dir} – skipping", file=sys.stderr)
            return None
        print(f"Error receiving '{stream}':\n{stderr}", file=sys.stderr)
        sys.exit(1)

    # Extract subvolume name reported by btrfs
    subvol_name = None
    for line in stderr.splitlines():
        line = line.strip()
        if "At subvol" in line or "Receiving subvol" in line:
            parts = line.split()
            for i, tok in enumerate(parts):
                if tok in ("subvol", "subvolume") and i + 1 < len(parts):
                    subvol_name = parts[i + 1].strip("'\"")
                    break
        if subvol_name:
            break

    if not subvol_name:
        subvol_name = stream.stem

    log(f"Received subvolume: {subvol_name}", 1, cfg["verbose"])
    return subvol_name

def archive_name_from_received(name: str) -> str:
    """Extract archive portion from conventional {archive}.{timestamp} name."""
    if "." in name:
        return name.rsplit(".", 1)[0]
    return name

def run_hook(cmd_template: str | None, mapping: dict[str, str], cfg: dict) -> None:
    if not cmd_template:
        log(f"\tNo hook to process", 1, cfg["verbose"])
        return
    cmd = cmd_template
    for key, val in mapping.items():
        cmd = cmd.replace(f"{{{key}}}", val)
    log(f"\tRunning hook: {cmd}", 1, cfg["verbose"])
    if not cfg.get("dry_run"):
        subprocess.run(cmd, shell=True, check=False)

# ---------------------------------------------------------------------------
# Keep Policy- (simple Borg-inspired, ported from btrbu
#  The implementation walks backwards using interval boundaries to help
#  determine what gets kept after a particular keep interval is completed.
#  The hourly boundary is the previous hour, the day is 23:59 of the previous 
#  day, the week is Saturday 11:59:59, the month is the last day of the month
#  the year is 12/31@23:59:59.
# ---------------------------------------------------------------------------
#
# keep policy helpers
def parse_ts(name: str) -> datetime | None:
    try:
        # expected form archive.YYYYMMDDHHMM
        ts = name.rsplit(".", 1)[-1]
        return datetime.strptime(ts, "%Y%m%d%H%M")
    except Exception:
        return None

def _ts_str(dt: datetime) -> str:
    return dt.strftime("%Y%m%d%H%M")

def _parse_ts_str(ts: str) -> datetime:
    return datetime.strptime(ts, "%Y%m%d%H%M")

_ARCHIVE_TS_RE = re.compile(r"^(.+)\.(\d{12})$")

def iter_archive_items(directory: Path, archive: str):
    """Yield (timestamp_str, path) for exact archive.YYYYMMDDHHMM entries."""
    for p in directory.iterdir():
        if not p.is_dir() and not p.is_symlink():
            # snapshots/backups are subvolumes (dirs); skip plain files
            # remove this guard if you also prune stream files later
            continue
        m = _ARCHIVE_TS_RE.match(p.name)
        if not m:
            continue
        if m.group(1) != archive:
            continue
        ts = m.group(2)
        # validate it's a real datetime
        if parse_ts(p.name) is None:
            continue
        yield ts, p

def _prev_hour(ts: str, hrs_cnt: int) -> str:
    t = _parse_ts_str(ts) - timedelta(hours=hrs_cnt)
    return f"{t.year:04d}{t.month:02d}{t.day:02d}{t.hour:02d}59"

def _prev_day(ts: str, days_cnt: int) -> str:
    t = _parse_ts_str(ts) - timedelta(days=days_cnt)
    return f"{t.year:04d}{t.month:02d}{t.day:02d}2359"

def _prev_week(ts: str, week_cnt: int) -> str:
    """Most recent Saturday at or before ts, then week_cnt weeks further back."""
    t = _parse_ts_str(ts)
    # Python: Monday=0 ... Sunday=6.  btrbu used Sunday=1 ... Saturday=7.
    # Align to previous Saturday (or same day if already Saturday).
    # Saturday in Python weekday() is 5.
    days_since_sat = (t.weekday() - 5) % 7
    if days_since_sat != 0:
        t = t - timedelta(days=days_since_sat)
    t = t - timedelta(weeks=week_cnt)
    return f"{t.year:04d}{t.month:02d}{t.day:02d}2359"

def _prev_month(ts: str, months_cnt: int) -> str:
    """Last day of the target month (23:59), matching btrbu semantics."""
    t = _parse_ts_str(ts)
    # last day of current month
    if t.month == 12:
        last_this = datetime(t.year + 1, 1, 1) - timedelta(days=1)
    else:
        last_this = datetime(t.year, t.month + 1, 1) - timedelta(days=1)

    if months_cnt != 0:
        # last day of (month - months_cnt)
        y, m = t.year, t.month - months_cnt
        while m <= 0:
            m += 12
            y -= 1
        # day=0 of next month => last day of target month
        if m == 12:
            t = datetime(y + 1, 1, 1) - timedelta(days=1)
        else:
            t = datetime(y, m + 1, 1) - timedelta(days=1)
        return f"{t.year:04d}{t.month:02d}{t.day:02d}2359"
    elif t.day != last_this.day:
        # not last day of month → last day of previous month
        t = datetime(t.year, t.month, 1) - timedelta(days=1)
        return f"{t.year:04d}{t.month:02d}{t.day:02d}2359"
    else:
        return f"{t.year:04d}{t.month:02d}{t.day:02d}2359"

def _prev_year(ts: str, years_cnt: int) -> str:
    t = _parse_ts_str(ts)
    if years_cnt != 0:
        return f"{t.year - years_cnt:04d}12312359"
    if t.month != 12 or t.day != 31:
        return f"{t.year - 1:04d}12312359"
    return f"{t.year:04d}12312359"

def _get_keeps(
    timestamps: list[str],
    keep_tbl: dict[str, str],
    max_keeps: int,
    ts_start: str,
    interval_label: str,
    interval_f,
) -> str | None:
    """
    Walk timestamps (ascending) from the newest entry <= ts_start backward,
    keeping one per interval.  Returns the oldest timestamp kept in this pass.
    """
    i = len(timestamps) - 1
    while i >= 0 and timestamps[i] > ts_start:
        i -= 1
    if i < 0:
        return None

    keep_cnt = 0
    oldest_keep = None
    while i >= 0:
        keep_tbl[timestamps[i]] = interval_label
        oldest_keep = timestamps[i]
        keep_cnt += 1
        if keep_cnt == max_keeps:
            return oldest_keep
        tsref = interval_f(timestamps[i], 1)
        i -= 1
        while i >= 0 and timestamps[i] > tsref:
            i -= 1
    return oldest_keep

def build_keep_set(ts_list: list[str], keep: dict) -> dict[str, str]:
    """
    Port of btrbu bldKeepList.
    ts_list: sorted ascending list of 'YYYYMMDDHHMM' strings.
    Returns dict { timestamp_str: reason } for timestamps to keep.
    """
    keep_hourly = keep.get("keep_hourly", 0)
    keep_daily = keep.get("keep_daily", 0)
    keep_weekly = keep.get("keep_weekly", 0)
    keep_monthly = keep.get("keep_monthly", 0)
    keep_yearly = keep.get("keep_yearly", 0)
    total = keep_hourly + keep_daily + keep_weekly + keep_monthly + keep_yearly

    if not ts_list:
        return {}

    keeps: dict[str, str] = {}
    newest = ts_list[-1]

    if total == 0:
        keeps[newest] = "d"
        return keeps

    # Always keep the most recent
    keeps[newest] = "1"

    if total == 1:
        keeps[newest] = "d"
        return keeps

    oldest_keep: str | None = None

    if keep_hourly:
        keeps[newest] = "h"
        if keep_hourly == 1:
            oldest_keep = newest
        else:
            oldest_keep = _get_keeps(
                ts_list, keeps, keep_hourly - 1,
                _prev_hour(newest, 1), "h", _prev_hour,
            )

    if keep_daily:
        dkeepn = keep_daily
        if keeps.get(newest) == "1":
            keeps[newest] = "d"
        if keep_hourly == 0:
            dkeepn -= 1
        if dkeepn == 0:
            oldest_keep = newest
        else:
            oldest_keep = _get_keeps(
                ts_list, keeps, dkeepn,
                _prev_day(newest, 1), "d", _prev_day,
            )

    if keep_weekly:
        wkeepn = keep_weekly
        if keeps.get(newest) == "1":
            keeps[newest] = "w"
        if keep_hourly + keep_daily == 0:
            wkeepn -= 1
        if wkeepn == 0:
            oldest_keep = newest
        else:
            base = oldest_keep or newest
            oldest_keep = _get_keeps(
                ts_list, keeps, wkeepn,
                _prev_week(_prev_day(base, 1), 0), "w", _prev_week,
            )

    if keep_monthly:
        mkeepn = keep_monthly
        if keeps.get(newest) == "1":
            keeps[newest] = "m"
        if keep_hourly + keep_daily + keep_weekly == 0:
            mkeepn -= 1
        if mkeepn == 0:
            oldest_keep = newest
        else:
            base = oldest_keep or newest
            oldest_keep = _get_keeps(
                ts_list, keeps, mkeepn,
                _prev_month(_prev_day(base, 1), 0), "m", _prev_month,
            )

    if keep_yearly:
        ykeepn = keep_yearly
        if keeps.get(newest) == "1":
            keeps[newest] = "y"
        if keep_hourly + keep_daily + keep_weekly + keep_monthly == 0:
            ykeepn -= 1
        if ykeepn != 0:
            base = oldest_keep or newest
            _get_keeps(
                ts_list, keeps, ykeepn,
                _prev_year(_prev_day(base, 1), 0), "y", _prev_year,
            )

    return keeps

def apply_keep_policy(directory: Path, archive: str, keep: dict, cfg: dict) -> None:
    """
    Apply the given keep policy to snapshots or backups of an archive.
    Uses the btrbu algorithm (non-overlapping interval slots from newest backward).
    """
    keep_values = [
        keep.get("keep_hourly", 0),
        keep.get("keep_daily", 0),
        keep.get("keep_weekly", 0),
        keep.get("keep_monthly", 0),
        keep.get("keep_yearly", 0),
    ]

    if not any(v > 0 for v in keep_values):
        log(f"No keep policy specified for {archive} – skipping pruning", 1, cfg["verbose"])
        return

    log(f"Keep policy for {archive}: {format_keep_policy(keep)}", 1, cfg["verbose"])
    log(f"Applying to {archive} in {directory}:", 1, cfg["verbose"])

    items = list(iter_archive_items(directory, archive))
    if not items:
        log(f"\tNo prior archives for {archive} found in {directory}", 1, cfg["verbose"])
        return

    # ascending timestamp order (btrbu style)
    items.sort(key=lambda x: x[0])
    ts_list = [t for t, _ in items]
    path_by_ts = {t: p for t, p in items}

    keeps = build_keep_set(ts_list, keep)

    for t, p in items:
        if t in keeps:
            log(f"\tKeeping {p.name} ({keeps[t]})", 1, cfg["verbose"])
        else:
            log(f"\tPruning {p.name}", 1, cfg["verbose"])
            cmd = btrfs_cmd(cfg, "subvolume", "delete", str(p))
            try:
                run(cmd,
                    dry_run=cfg.get("dry_run", False),
                    verbosity=cfg["verbose"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=True)
            except subprocess.CalledProcessError:
                print(f"Error during prune: `{cmd}`", file=sys.stderr)
                sys.exit(1)

#-----------------------------------------------------------------
# Does all archive related actions
#-----------------------------------------------------------------
def process_archive(archive: dict, cfg: dict) -> None:
    """
    Normal processing for a single archive:
    pre-hook → snapshot → post-snapshot-hook → backup → post-backup-hook → keep policy
    If just send_to_file:
    pre-hook -> snapshot -> post-snapshot-hook -> send backup to file -> keep for snapshots
    If just recv_from_file:
    backup receive from file -> post-backup-hook -> keep for backups
    If both send_to and recv_from then same as Normal above except the backup uses a file
    as a staging step.
    Processing for send_to_dir and recv_from_dir uses same processing flow except it will
    handle multiple archives versus a single archive for the file variant 
    """
    name = archive["name"]
    subvol = archive["subvolume"]
    snap_dir = Path(cfg["snapshot_dir"]) if cfg.get("snapshot_dir") else None
    backup_dir = Path(cfg["backup_dir"]) if cfg.get("backup_dir") else None

    log(f"=== Processing archive: {name} ({subvol}) ===", 1, cfg["verbose"])

    send_file = archive.get("send_to_file")
    recv_file = archive.get("receive_from_file")
    send_dir  = archive.get("send_to_dir")
    recv_dir  = archive.get("receive_from_dir")
    snaps_only = archive.get("snaps_only", False)

    # ----- receive-only (file) -----
    if recv_file and not send_file:
        if not backup_dir:
            print(f"Error: archive '{name}' receive_from_file requires backup_dir",
                  file=sys.stderr)
            sys.exit(1)
        chk_btrfs_subvolume(backup_dir, cfg)
        p = Path(recv_file)
        if not p.is_file() or not is_btrfs_stream(p, cfg):
            print(f"Error: '{p}' is not a valid btrfs stream file", file=sys.stderr)
            sys.exit(1)
        received = receive_stream(p, backup_dir, cfg)
        if received:
            run_hook(archive.get("post_backup_hook"), {
                "backup": str(backup_dir / received),
                "snapshot": "",
                "archive": name,
                "timestamp": timestamp(),
                "snapshotdir": str(snap_dir or ""),
                "backupdir": str(backup_dir),
            }, cfg)
            apply_keep_policy(backup_dir, name, archive["keep"], cfg)
        return

    # ----- receive-only (dir) -----
    if recv_dir and not send_dir and not send_file:
        if not backup_dir:
            print(f"Error: receive_from_dir requires backup_dir", file=sys.stderr)
            sys.exit(1)
        chk_btrfs_subvolume(backup_dir, cfg)
        stream = find_newest_stream_for_archive(Path(recv_dir), name, cfg)
        if not stream:
            log(f"No matching stream for archive '{name}' in {recv_dir}", 1, cfg["verbose"])
            return
        log(f"Using stream {stream} for archive {name}", 1, cfg["verbose"])
        received = receive_stream(stream, backup_dir, cfg)
        if received:
            run_hook(archive.get("post_backup_hook"), {
                "backup": str(backup_dir / received),
                "snapshot": "",
                "archive": name,
                "timestamp": timestamp(),
                "snapshotdir": str(snap_dir or ""),
                "backupdir": str(backup_dir),
            }, cfg)
            apply_keep_policy(backup_dir, name, archive["keep"], cfg)
        return

    # ----- paths that create a snapshot -----
    if not snap_dir:
        print("Error: snapshot_dir is required for snapshot/send operations",
              file=sys.stderr)
        sys.exit(1)
    chk_btrfs_subvolume(Path(subvol), cfg)
    chk_btrfs_subvolume(snap_dir, cfg)

    log("Running pre-snapshot hook...", 1, cfg["verbose"])
    run_hook(archive.get("pre_snapshot_hook"), {
        "archive": name, "subvol": subvol, "timestamp": timestamp(),
        "snapshotdir": str(snap_dir),
        "backupdir": str(backup_dir) if backup_dir else "",
    }, cfg)

    log("Creating snapshot...", 1, cfg["verbose"])
    snap = create_snapshot(name, subvol, snap_dir, cfg)

    log("Running post-snapshot hook...", 1, cfg["verbose"])
    run_hook(archive.get("post_snapshot_hook"), {
        "snapshot": str(snap), "archive": name, "timestamp": timestamp(),
        "snapshotdir": str(snap_dir),
        "backupdir": str(backup_dir) if backup_dir else "",
    }, cfg)

    stream_path: Path | None = None

    # send to explicit file
    if send_file:
        stream_path = Path(send_file)
        send_backup_tofile(snap, snap_dir, backup_dir, stream_path, cfg, name)

    # send to directory → {archive}.{timestamp}.btrfs
    elif send_dir:
        chk_is_dir(send_dir, "send-to-dir")
        stream_path = Path(send_dir) / f"{snap.name}.btrfs"
        send_backup_tofile(snap, snap_dir, backup_dir, stream_path, cfg, name)

    # normal piped send|receive
    elif not snaps_only and backup_dir:
        log("Starting backup...", 1, cfg["verbose"])
        dest = send_backup(snap, snap_dir, backup_dir, cfg, name)
        run_hook(archive.get("post_backup_hook"), {
            "backup": str(dest), "snapshot": str(snap), "archive": name,
            "timestamp": timestamp(), "snapshotdir": str(snap_dir),
            "backupdir": str(backup_dir),
        }, cfg)
        apply_keep_policy(snap_dir, name, archive["keep"], cfg)
        apply_keep_policy(backup_dir, name, archive["keep"], cfg)
        log(f"Finished archive: {name}\n", 1, cfg["verbose"])
        return
    else:
        # snaps_only or no backup
        apply_keep_policy(snap_dir, name, archive["keep"], cfg)
        log(f"Finished archive: {name}\n", 1, cfg["verbose"])
        return

    # If we sent to a file/dir, optionally receive it
    if stream_path and (recv_file or recv_dir or send_file and recv_file):
        # both file options → same file; both dir options → just-created file
        if not backup_dir:
            print("Error: receive requires backup_dir", file=sys.stderr)
            sys.exit(1)
        chk_btrfs_subvolume(backup_dir, cfg)
        received = receive_stream(stream_path, backup_dir, cfg)
        if received:
            run_hook(archive.get("post_backup_hook"), {
                "backup": str(backup_dir / received),
                "snapshot": str(snap),
                "archive": name,
                "timestamp": timestamp(),
                "snapshotdir": str(snap_dir),
                "backupdir": str(backup_dir),
            }, cfg)
            apply_keep_policy(backup_dir, name, archive["keep"], cfg)

    # keep on snapshots whenever we created one
    apply_keep_policy(snap_dir, name, archive["keep"], cfg)
    log(f"Finished archive: {name}\n", 1, cfg["verbose"])

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> int:

    parser = argparse.ArgumentParser(
        description="btrfs snapshot & backup tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  bubtrsnap --snapshot-dir=/pool/snapshots --backup-dir=/backup home=/home
  bubtrsnap --config=~/.config/bubtrsnap.toml
  bubtrsnap -v --snaps-only root=/
  bubtrsnap --send-to-file /dirfor/streamdata/file/ maildir=/home/user/Maildir
        """
    )

    # Global options
    parser.add_argument(
        "--config",
        type=Path,
        help="Path to TOML configuration file (default: ~/.config/bubtrsnap.toml)"
    )
    parser.add_argument(
        "--snapshot-dir",
        type=str,
        help="Directory where read-only snapshots will be created"
    )
    parser.add_argument(
        "--backup-dir",
        type=str,
        help="Directory where backups will be sent via btrfs send/receive"
    )
    parser.add_argument(
        "--snaps-only",
        action="store_true",
        help="Only create snapshots; skip the backup step"
    )
    parser.add_argument("--send-to-file", type=str, metavar="FILE",
        help="Send stream to FILE (archive-specific). Exactly one archive required. "
             "Mutually exclusive with --snaps-only and the *-dir options.")
    parser.add_argument("--receive-from-file", type=str, metavar="FILE",
        help="Receive stream from FILE (archive-specific). Exactly one archive required. "
             "If used with --send-to-file, both must name the same file.")
    parser.add_argument("--send-to-dir", type=str, metavar="DIR",
        help="Write per-archive streams into DIR as {archive}.{timestamp}.btrfs. "
             "Global; applies to CLI archives or all config archives.")
    parser.add_argument("--receive-from-dir", type=str, metavar="DIR",
        help="Receive newest matching stream for each archive from DIR.")
    parser.add_argument(
        "--sudo",
        action="store_true",
        help="Run btrfs commands with 'sudo -n'"
    )

    # Keep policy (CLI keeps are all-or-nothing)
    parser.add_argument("--keep-hourly", type=int, metavar="N", help="Number of hourly snapshots/backups to retain")
    parser.add_argument("--keep-daily", type=int, metavar="N", help="Number of daily snapshots/backups to retain")
    parser.add_argument("--keep-weekly", type=int, metavar="N", help="Number of weekly snapshots/backups to retain")
    parser.add_argument("--keep-monthly", type=int, metavar="N", help="Number of monthly snapshots/backups to retain")
    parser.add_argument("--keep-yearly", type=int, metavar="N", help="Number of yearly snapshots/backups to retain")

    # Verbosity
    parser.add_argument(
        "-v", "--verbose",
        type=int,
        nargs="?",
        const=1,
        default=0,
        metavar="LEVEL",
        help="Verbosity level: 0=quiet (default), 1=progress, 2=commands. "
             "-v alone means level 1, --verbose 2 means level 2"
    )
    parser.add_argument(
        "--debug",
        action="store_true",
        help="Enable debug output (highest level)"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be done without making changes (implies -vv)"
    )
    parser.add_argument(
        "archives",
        nargs="*",
        metavar="ARCHIVE[=SUBVOLUME]",
        help="Archives to process. Can be just the archive name (looked up in the "
             "config file) or name=/path/to/subvolume. "
             "If none are given, all archives from the config file are processed."
    )

    # parse them args...
    args = parser.parse_args()

    # various pre-checks for certain options and option combinations
    # snaps-only and either of the send-to-* or recv-from-* don't make sense
    # so we'll flag that...
    if args.snaps_only and (args.send_to_file or args.receive_from_file
                            or args.send_to_dir or args.receive_from_dir):
        print("Error: --snaps-only is mutually exclusive with send/receive file and directory options",
              file=sys.stderr)
        return 1
    # don't mix file specific send/recv options with dir versions of the options
    if (args.send_to_file or args.receive_from_file) and (args.send_to_dir or args.receive_from_dir):
        print("Error: cannot mix --send-to-file/--receive-from-file with "
              "--send-to-dir/--receive-from-dir", file=sys.stderr)
        return 1
    # send-to-file and recv-from-file, if both present, must use the same file
    if args.send_to_file and args.receive_from_file and args.send_to_file != args.receive_from_file:
        print("Error: --send-to-file and --receive-from-file must name the same file",
              file=sys.stderr)
        return 1

    if args.send_to_file and args.archives and len(args.archives) > 1:
        print("Error: --send-to-file may be used with only one archive", file=sys.stderr)
        return 1

        # Verbosity handling 
    verbosity = args.verbose
    if args.debug:
        verbosity = 3
    if args.dry_run:
        verbosity = max(verbosity, 2)

    config_path = args.config or Path.home() / ".config" / "bubtrsnap.toml"

    try:
        global_cfg, archives = load_and_resolve_archives(
            args, config_path if config_path.exists() else None
        )
    except SystemExit:
        return 1

    global_cfg["verbose"] = verbosity
    global_cfg["dry_run"] = args.dry_run

    # see if we're doing a recv only operation....
    receive_only = all(
        (a.get("receive_from_file") or a.get("receive_from_dir"))
        and not a.get("send_to_file") and not a.get("send_to_dir")
        and not a.get("snaps_only")
        for a in archives
    ) if archives else False

    # if not doing just a recv, then taking snapshots and snapshot_dir is needed
    if not receive_only and not global_cfg.get("snapshot_dir"):
        print("--snapshot-dir is required", file=sys.stderr)
        return 1

    if not archives:
        print("No archives to process.", file=sys.stderr)
        return 1

    # Make sure snapshot_dir and backup_dir are valid btrfs subvolumes
    # otherwise, what are we doing here?
    log("Verifying snapshot and backups directories are valid btrfs subvolumes...", 1, global_cfg["verbose"])
    for path in [ global_cfg["snapshot_dir"], global_cfg["backup_dir"] ]:
        chk_btrfs_subvolume(path, global_cfg)

    # Process each archive fully
    for archive in archives:
        try:
            process_archive(archive, global_cfg)
        except Exception as e:
            log(f"Error processing {archive['name']}: {e}", 1, global_cfg["verbose"])
            return 1

    log("All archives processed.", 1, global_cfg["verbose"])
    return 0    

if __name__ == "__main__":
    sys.exit(main())
