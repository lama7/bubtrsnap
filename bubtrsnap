def btrfs_cmd(cfg: dict, *args: str) -> list[str]:
    cmd = ["btrfs"]
    if cfg.get("sudo"):
        cmd = ["sudo", "-n"] + cmd
    return cmd + list(args)

# makes sure the dir is a subvolume, errors out if not
def chk_btrfs_subvolume(dir: Path, cfg: dict):
    try:
        run(btrfs_cmd(cfg, "subvolume", "show", str(dir)),
            dry_run=False,
            verbosity=cfg["verbose"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True)
        log(f"\t{dir} is a valid btrfs subvolume", 2, cfg["verbose"])
                                   
    except subprocess.CalledProcessError:
        print(f"Error: '{dir}' is not a btrfs subvolume "
        f"(required for snapshot/backup/receive operations)", file=sys.stderr)
        sys.exit(1)

def chk_btrfs_subvolume_ssh(remote: str, remote_dir: str, cfg: dict):
    """Check if a remote directory is a btrfs subvolume via SSH."""
    # Build SSH command: ssh remote sudo -n btrfs subvolume show remote_dir
    sudo_prefix = ["sudo", "-n"] if cfg.get("sudo") else []
    ssh_cmd = ["ssh", remote] + sudo_prefix + ["btrfs", "subvolume", "show", remote_dir]
    
    if cfg.get("dry_run"):
        log(f"[dry-run] {' '.join(ssh_cmd)}", 2, cfg["verbose"])
        return
    
    try:
        result = subprocess.run(ssh_cmd, check=True, capture_output=True, text=True, timeout=30)
        log(f"\t{remote}:{remote_dir} is a valid btrfs subvolume", 2, cfg["verbose"])
    except subprocess.CalledProcessError as e:
        print(f"Error: '{remote}:{remote_dir}' is not a btrfs subvolume "
              f"(required for snapshot/backup/receive operations)", file=sys.stderr)
        if e.stderr:
            print(f"  SSH error: {e.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print(f"Error: SSH connection to {remote} timed out", file=sys.stderr)
        sys.exit(1)

def create_snapshot(archive: str, subvol: str, snap_dir: Path, cfg: dict) -> Path:
    name = f"{archive}.{timestamp()}"
    dest = snap_dir / name
    cmd = btrfs_cmd(cfg, "subvolume", "snapshot", "-r", subvol, str(dest))
    try:
        run(cmd, 
            dry_run=cfg.get("dry_run", False),
            verbosity=cfg["verbose"],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        print(f"Error executing `{cmd}`")
        sys.exit(1)

    return dest

def get_subvol_uuids(path: Path, cfg: dict) -> tuple[str | None, str | None]:
    """
    Returns (UUID, Received UUID) for a btrfs subvolume.
    Returns (None, None) on failure.
    """
    try:
        result = run(btrfs_cmd(cfg, "subvolume", "show", str(path)),
                     dry_run=False, # this allows code to be executed properly during a dry-run
                     verbosity=cfg["verbose"],
                     check=True,  
                     capture_output=True, 
                     text=True)
        uuid = None
        received_uuid = None
        for line in result.stdout.splitlines():
            line = line.strip()
            if line.startswith("UUID:"):
                uuid = line.split(":", 1)[1].strip()
            elif line.startswith("Received UUID:"):
                val = line.split(":", 1)[1].strip()
                received_uuid = None if val == "-" else val

        # Debug level only
        log(f"{path}: UUID={uuid}  Received UUID={received_uuid}", 3, cfg["verbose"])
        return uuid, received_uuid
    except subprocess.CalledProcessError:
        log(f"Failed to get UUIDs for {path}", 3, cfg["verbose"])
        return None, None


def get_subvol_uuids_ssh(remote: str, remote_path: str, cfg: dict) -> tuple[str | None, str | None]:
    """
    Returns (UUID, Received UUID) for a btrfs subvolume on a remote host via SSH.
    Returns (None, None) on failure.
    """
    cmd = build_ssh_cmd(remote, btrfs_cmd(cfg, "subvolume", "show", remote_path))
    try:
        result = run(cmd, dry_run=False, verbosity=cfg["verbose"],
                     check=True, capture_output=True, text=True)
        uuid = None
        received_uuid = None
        for line in result.stdout.splitlines():
            line = line.strip()
            if line.startswith("UUID:"):
                uuid = line.split(":", 1)[1].strip()
            elif line.startswith("Received UUID:"):
                val = line.split(":", 1)[1].strip()
                received_uuid = None if val == "-" else val

        log(f"{remote}:{remote_path}: UUID={uuid}  Received UUID={received_uuid}", 3, cfg["verbose"])
        return uuid, received_uuid
    except subprocess.CalledProcessError:
        log(f"Failed to get UUIDs for {remote}:{remote_path}", 3, cfg["verbose"])
        return None, None


def find_parents(archive: str, snapshot_dir: Path, backup_dir: Path, cfg: dict) -> list[Path]:
    """
    Find previous snapshots in snapshot_dir that have already been
    successfully received to backup_dir (matched by UUID ↔ Received UUID).
    Returns them newest-first.
    """
    log(f"Finding parent subvolumes for {archive}", 2, cfg["verbose"])
    # Collect snapshots
    snapshots = []
    for p in snapshot_dir.glob(f"{archive}.*"):
        if not p.is_dir():
            continue
        uuid, _ = get_subvol_uuids(p, cfg)
        if uuid:
            ts = parse_ts(p.name)
            if ts:
                snapshots.append((ts, p, uuid))

    # Collect received UUIDs from backup side
    received_uuids = set()
    for p in backup_dir.glob(f"{archive}.*"):
        if not p.is_dir():
            continue
        _, received_uuid = get_subvol_uuids(p, cfg)
        if received_uuid:
            received_uuids.add(received_uuid)

    # Match
    parents = []
    for ts, path, uuid in snapshots:
        if uuid in received_uuids:
            parents.append((ts, path))
            log(f"Usable parent: {path.name}", 3, cfg["verbose"])

    parents.sort(key=lambda x: x[0], reverse=True)
    result = [path for _, path in parents]

    if result:
        log(f"Found {len(result)} usable parent(s) for {archive}", 3, cfg["verbose"])
    else:
        log("No usable parents found", 3, cfg["verbose"])

    return result


def find_parents_ssh(archive: str, snapshot_dir: Path, remote: str, remote_dir: str, cfg: dict) -> list[Path]:
    """
    Find previous snapshots in snapshot_dir that have already been
    successfully received to remote_dir via SSH (matched by UUID ↔ Received UUID).
    Returns them newest-first.
    """
    log(f"Finding parent subvolumes for {archive} on SSH remote {remote}:{remote_dir}", 2, cfg["verbose"])
    # Collect snapshots
    snapshots = []
    for p in snapshot_dir.glob(f"{archive}.*"):
        if not p.is_dir():
            continue
        uuid, _ = get_subvol_uuids(p, cfg)
        if uuid:
            ts = parse_ts(p.name)
            if ts:
                snapshots.append((ts, p, uuid))

    # Collect received UUIDs from remote backup side
    # Need to run `btrfs subvolume show` on each subvolume to get Received UUID
    received_uuids = set()
    cmd = build_ssh_cmd(remote, btrfs_cmd(cfg, "subvolume", "list", remote_dir))
    try:
        result = run(cmd, dry_run=False, verbosity=cfg["verbose"],
                     check=True, capture_output=True, text=True)
        for line in result.stdout.splitlines():
            # Parse: ID 256 gen 1234 top level 5 path lama7.20260831...
            # Extract the path (subvolume name)
            parts = line.split()
            path_idx = -1
            for i, part in enumerate(parts):
                if part == "path" and i + 1 < len(parts):
                    path_idx = i + 1
                    break
            if path_idx >= 0:
                remote_subvol = parts[path_idx]
                # Only process subvolumes matching our archive pattern
                if remote_subvol.startswith(f"{archive}."):
                    # Run btrfs subvolume show on this specific subvolume to get Received UUID
                    show_cmd = build_ssh_cmd(remote, btrfs_cmd(cfg, "subvolume", "show", f"{remote_dir}/{remote_subvol}"))
                    try:
                        show_result = run(show_cmd, dry_run=False, verbosity=cfg["verbose"],
                                          check=True, capture_output=True, text=True)
                        # Parse output for Received UUID
                        for show_line in show_result.stdout.splitlines():
                            show_line = show_line.strip()
                            if show_line.startswith("Received UUID:"):
                                received_uuid = show_line.split(":", 1)[1].strip()
                                if received_uuid and received_uuid != "-":
                                    received_uuids.add(received_uuid)
                                break
                    except subprocess.CalledProcessError:
                        log(f"Failed to show subvolume {remote_subvol} on {remote}:{remote_dir}", 3, cfg["verbose"])
    except subprocess.CalledProcessError:
        log(f"Failed to list subvolumes on {remote}:{remote_dir}", 3, cfg["verbose"])

    # Match
    parents = []
    for ts, path, uuid in snapshots:
        if uuid in received_uuids:
            parents.append((ts, path))
            log(f"Usable parent (SSH): {path.name}", 3, cfg["verbose"])

    parents.sort(key=lambda x: x[0], reverse=True)
    result = [path for _, path in parents]

    if result:
        log(f"Found {len(result)} usable parent(s) for {archive} on SSH remote", 3, cfg["verbose"])
    else:
        log("No usable parents found on SSH remote", 3, cfg["verbose"])

    return result


# ---------------------------------------------------------------------------
# SSH Helpers
# ---------------------------------------------------------------------------
def build_ssh_cmd(remote: str, remote_cmd: list[str]) -> list[str]:
    """Build an SSH command to run remote_cmd on the remote host."""
    return ["ssh", remote] + remote_cmd


def build_ssh_receive_cmd(remote: str, remote_dir: str, cfg: dict) -> list[str]:
    """Build the remote btrfs receive command via SSH."""
    recv_cmd = btrfs_cmd(cfg, "receive", remote_dir)
    return build_ssh_cmd(remote, recv_cmd)


def send_backup(snap: Path, snapshot_dir: Path, backup_dir: Path | None, cfg: dict, archive: str, archive_cfg: dict | None = None) -> Path:
    # Check if SSH remote is configured
    remote = archive_cfg.get("remote") if archive_cfg else cfg.get("remote")
    remote_dir = archive_cfg.get("remote_dir") if archive_cfg else cfg.get("remote_dir")

    dest = backup_dir / snap.name if backup_dir else Path(snap.name)

    # Find parents for local destination
    local_parents = find_parents(archive, snapshot_dir, backup_dir, cfg) if backup_dir else []
    
    # Find parents for SSH destination
    ssh_parents = find_parents_ssh(archive, snapshot_dir, remote, remote_dir, cfg) if (remote and remote_dir) else []

    # Build parent arguments for local destination
    local_send_cmd = btrfs_cmd(cfg, "send")
    for i, p in enumerate(local_parents):
        local_send_cmd += ["-p" if i == 0 else "-c", str(p)]
    local_send_cmd.append(str(snap))

    # Build parent arguments for SSH destination
    ssh_send_cmd = btrfs_cmd(cfg, "send")
    for i, p in enumerate(ssh_parents):
        ssh_send_cmd += ["-p" if i == 0 else "-c", str(p)]
    ssh_send_cmd.append(str(snap))

    # For dry-run, show what would happen
    if cfg.get("dry_run"):
        if remote and remote_dir:
            ssh_recv = build_ssh_receive_cmd(remote, remote_dir, cfg)
            if backup_dir:
                if local_parents:
                    log(f"Incremental send using {len(local_parents)} local parent(s) + {len(ssh_parents)} SSH parent(s)", 1, cfg["verbose"])
                else:
                    log("Full send (no matching parent found)", 1, cfg["verbose"])
                log(f"[dry-run] {' '.join(local_send_cmd)} | btrfs receive {backup_dir}", 2, cfg["verbose"])
                log(f"[dry-run] {' '.join(ssh_send_cmd)} | ssh {remote} {' '.join(ssh_recv[2:])}", 2, cfg["verbose"])
            else:
                if ssh_parents:
                    log(f"Incremental send using {len(ssh_parents)} SSH parent(s)", 1, cfg["verbose"])
                else:
                    log("Full send (no matching parent found)", 1, cfg["verbose"])
                log(f"[dry-run] {' '.join(ssh_send_cmd)} | ssh {remote} {' '.join(ssh_recv[2:])}", 2, cfg["verbose"])
        elif backup_dir:
            if local_parents:
                log(f"Incremental send using {len(local_parents)} parent(s)", 1, cfg["verbose"])
            else:
                log("Full send (no matching parent found)", 1, cfg["verbose"])
            log(f"[dry-run] {' '.join(local_send_cmd)} | btrfs receive {backup_dir}", 2, cfg["verbose"])
        else:
            log("Full send (no matching parent found)", 1, cfg["verbose"])
            log(f"[dry-run] {' '.join(ssh_send_cmd)} (no destination)", 2, cfg["verbose"])
        return dest

    start_time = datetime.now()

    has_local = backup_dir is not None
    has_remote = remote and remote_dir

    if not has_local and not has_remote:
        log("No backup destination configured (no backup_dir or remote/remote_dir)", 1, cfg["verbose"])
        return dest

    if has_remote and has_local:
        # Both local and remote: run send twice - once for each destination
        # First: local receive
        log("Sending to local backup...", 1, cfg["verbose"])
        recv_cmd = btrfs_cmd(cfg, "receive", str(backup_dir))
        send_proc1 = subprocess.Popen(local_send_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        recv_proc1 = subprocess.Popen(recv_cmd, stdin=send_proc1.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        send_proc1.stdout.close()
        recv_proc1.communicate()

        if recv_proc1.returncode != 0:
            raise RuntimeError("btrfs receive (local) failed")

        # Second: SSH receive
        log(f"Sending to SSH remote {remote}...", 1, cfg["verbose"])
        send_proc2 = subprocess.Popen(ssh_send_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        ssh_recv = build_ssh_receive_cmd(remote, remote_dir, cfg)
        ssh_proc2 = subprocess.Popen(ssh_recv, stdin=send_proc2.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        send_proc2.stdout.close()
        ssh_proc2.communicate()

        if ssh_proc2.returncode != 0:
            raise RuntimeError("btrfs receive via SSH failed")

    elif has_remote:
        # SSH only
        ssh_recv = build_ssh_receive_cmd(remote, remote_dir, cfg)
        send_proc = subprocess.Popen(ssh_send_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        ssh_proc = subprocess.Popen(ssh_recv, stdin=send_proc.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        send_proc.stdout.close()
        ssh_proc.communicate()

        elapsed = (datetime.now() - start_time).total_seconds()
        log(f"btrfs send/receive (SSH) completed in {format_duration(elapsed)}", 1, cfg["verbose"])

        if ssh_proc.returncode != 0:
            raise RuntimeError("btrfs receive via SSH failed")
    elif has_local:
        # Local only (original behavior)
        recv_cmd = btrfs_cmd(cfg, "receive", str(backup_dir))
        send_proc = subprocess.Popen(local_send_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        recv_proc = subprocess.Popen(recv_cmd, stdin=send_proc.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        send_proc.stdout.close()
        recv_proc.communicate()

        elapsed = (datetime.now() - start_time).total_seconds()
        log(f"btrfs send/receive completed in {format_duration(elapsed)}", 1, cfg["verbose"])

        if recv_proc.returncode != 0:
            raise RuntimeError("btrfs receive failed")

    return dest

def send_backup_tofile(snap: Path, snapshot_dir: Path, backup_dir: Path | None,
                       stream_file: Path, cfg: dict, archive: str, archive_cfg: dict | None = None) -> Path:
    """
    btrfs send -f <stream_file>.  Errors if stream_file already exists.
    If archive_cfg has remote/remote_dir, also sends to SSH destination.
    """
    # Check if SSH remote is configured
    remote = archive_cfg.get("remote") if archive_cfg else cfg.get("remote")
    remote_dir = archive_cfg.get("remote_dir") if archive_cfg else cfg.get("remote_dir")

    # Find parents for local destination
    local_parents = find_parents(archive, snapshot_dir, backup_dir, cfg) if backup_dir else []

    # Find parents for SSH destination
    ssh_parents = find_parents_ssh(archive, snapshot_dir, remote, remote_dir, cfg) if (remote and remote_dir) else []

    # Build parent arguments for local destination
    local_send_cmd = btrfs_cmd(cfg, "send")
    for i, p in enumerate(local_parents):
        local_send_cmd += ["-p" if i == 0 else "-c", str(p)]
    local_send_cmd += ["-f", str(stream_file), str(snap)]

    # Build parent arguments for SSH destination
    ssh_send_cmd = btrfs_cmd(cfg, "send")
    for i, p in enumerate(ssh_parents):
        ssh_send_cmd += ["-p" if i == 0 else "-c", str(p)]
    ssh_send_cmd += ["-f", str(stream_file), str(snap)]

    if stream_file.exists():
        print(f"Error: stream file already exists: {stream_file}", file=sys.stderr)
        print("Delete it manually or choose a different path.", file=sys.stderr)
        sys.exit(1)

    if cfg.get("dry_run"):
        if remote and remote_dir:
            ssh_recv = build_ssh_receive_cmd(remote, remote_dir, cfg)
            if backup_dir:
                if local_parents:
                    log(f"Incremental send using {len(local_parents)} local parent(s) + {len(ssh_parents)} SSH parent(s)", 1, cfg["verbose"])
                else:
                    log("Full send (no matching parent found)", 1, cfg["verbose"])
                log(f"[dry-run] {' '.join(local_send_cmd)} | btrfs receive {backup_dir}", 2, cfg["verbose"])
                log(f"[dry-run] {' '.join(ssh_send_cmd)} | ssh {remote} {' '.join(ssh_recv[2:])}", 2, cfg["verbose"])
            else:
                if ssh_parents:
                    log(f"Incremental send using {len(ssh_parents)} SSH parent(s)", 1, cfg["verbose"])
                else:
                    log("Full send (no matching parent found)", 1, cfg["verbose"])
                log(f"[dry-run] {' '.join(ssh_send_cmd)} | ssh {remote} {' '.join(ssh_recv[2:])}", 2, cfg["verbose"])
        elif backup_dir:
            if local_parents:
                log(f"Incremental send using {len(local_parents)} parent(s)", 1, cfg["verbose"])
            else:
                log("Full send (no matching parent found)", 1, cfg["verbose"])
            log(f"[dry-run] {' '.join(local_send_cmd)} | btrfs receive {backup_dir}", 2, cfg["verbose"])
        else:
            log("Full send to file (no matching parent found)", 1, cfg["verbose"])
            log(f"[dry-run] {' '.join(local_send_cmd)} (file only)", 2, cfg["verbose"])
        return stream_file

    has_local = backup_dir is not None
    has_remote = remote and remote_dir

    if not has_local and not has_remote:
        log("No backup destination configured (no backup_dir or remote/remote_dir)", 1, cfg["verbose"])
        return stream_file

    if has_remote:
        ssh_recv = build_ssh_receive_cmd(remote, remote_dir, cfg)
        log(f"{' '.join(ssh_send_cmd)} | ssh {remote} {' '.join(ssh_recv[2:])}", 2, cfg["verbose"])

    if has_local:
        recv_cmd = btrfs_cmd(cfg, "receive", str(backup_dir))
        log(f"{' '.join(local_send_cmd)} | {' '.join(recv_cmd)}", 2, cfg["verbose"])

    start_time = datetime.now()

    if has_remote and has_local:
        # Both local and remote: run send twice - once for each destination
        # First: local receive
        log("Sending to local backup...", 1, cfg["verbose"])
        send_proc1 = subprocess.Popen(local_send_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        recv_proc1 = subprocess.Popen(recv_cmd, stdin=send_proc1.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        send_proc1.stdout.close()
        recv_proc1.communicate()

        if recv_proc1.returncode != 0:
            raise RuntimeError("btrfs receive (local) failed")

        # Second: SSH receive
        log(f"Sending to SSH remote {remote}...", 1, cfg["verbose"])
        send_proc2 = subprocess.Popen(ssh_send_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        ssh_proc2 = subprocess.Popen(ssh_recv, stdin=send_proc2.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        send_proc2.stdout.close()
        ssh_proc2.communicate()

        if ssh_proc2.returncode != 0:
            raise RuntimeError("btrfs receive via SSH failed")

    elif has_remote:
        # SSH only
        send_proc = subprocess.Popen(ssh_send_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        ssh_proc = subprocess.Popen(ssh_recv, stdin=send_proc.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        send_proc.stdout.close()
        ssh_proc.communicate()

        elapsed = (datetime.now() - start_time).total_seconds()
        log(f"btrfs send/receive (SSH) completed in {format_duration(elapsed)}", 1, cfg["verbose"])

        if ssh_proc.returncode != 0:
            raise RuntimeError("btrfs receive via SSH failed")
    elif has_local:
        # Local only (original behavior)
        send_proc = subprocess.Popen(local_send_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        recv_proc = subprocess.Popen(recv_cmd, stdin=send_proc.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        send_proc.stdout.close()
        recv_proc.communicate()

        elapsed = (datetime.now() - start_time).total_seconds()
        log(f"btrfs send/receive completed in {format_duration(elapsed)}", 1, cfg["verbose"])

        if recv_proc.returncode != 0:
            raise RuntimeError("btrfs receive failed")

    # Also write to file if requested (without parent args - it's a full send to file)
    send_to_file = btrfs_cmd(cfg, "send", "-f", str(stream_file), str(snap))
    log(f"{' '.join(send_to_file)}", 2, cfg["verbose"])
    result = subprocess.run(send_to_file, capture_output=True, check=False)
    if result.returncode != 0:
        raise RuntimeError(f"btrfs send to file failed: {result.stderr}")

    return stream_file

def receive_stream(stream: Path, backup_dir: Path | None, cfg: dict, remote: str | None = None, remote_dir: str | None = None) -> str | None:
    """
    Execute `btrfs receive -f <stream> <backup_dir>`.
    If remote/remote_dir provided, stream via SSH: `cat <stream> | ssh remote btrfs receive remote_dir`.
    If only remote/remote_dir (no backup_dir), receive only via SSH.
    Returns the received subvolume basename on success, None on 'already exists'.
    Aborts the whole program on any other error.
    """
    if remote and remote_dir:
        # SSH mode: cat stream | ssh remote btrfs receive remote_dir
        recv_cmd = build_ssh_receive_cmd(remote, remote_dir, cfg)
        # Use cat to stream the file over SSH
        cat_cmd = ["cat", str(stream)]
        
        if cfg.get("dry_run"):
            log(f"[dry-run] {' '.join(cat_cmd)} | ssh {remote} {' '.join(recv_cmd[2:])}", 2, cfg["verbose"])
            return stream.stem
        
        log(f"{' '.join(cat_cmd)} | ssh {remote} {' '.join(recv_cmd[2:])}", 2, cfg["verbose"])
        start = datetime.now()
        
        cat_proc = subprocess.Popen(cat_cmd, stdout=subprocess.PIPE)
        ssh_proc = subprocess.Popen(recv_cmd, stdin=cat_proc.stdout, 
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        cat_proc.stdout.close()
        ssh_stdout, ssh_stderr = ssh_proc.communicate()
        
        elapsed = (datetime.now() - start).total_seconds()
        log(f"btrfs receive via SSH completed in {format_duration(elapsed)}", 1, cfg["verbose"])
        
        stderr = (ssh_stderr or "").strip()
        
        if ssh_proc.returncode != 0:
            if "already exists" in stderr.lower():
                print(f"Warning: subvolume from '{stream.name}' already exists in "
                      f"{remote_dir} – skipping", file=sys.stderr)
                return None
            print(f"Error receiving '{stream}' via SSH:\n{stderr}", file=sys.stderr)
            sys.exit(1)
        
        # Extract subvolume name reported by btrfs
        subvol_name = None
        for line in stderr.splitlines():
            line = line.strip()
            if "At subvol" in line or "Receiving subvol" in line:
                parts = line.split()
                for i, tok in enumerate(parts):
                    if tok in ("subvol", "subvolume") and i + 1 < len(parts):
                        subvol_name = parts[i + 1].strip("'\"")
                        break
            if subvol_name:
                break
        
        if not subvol_name:
            subvol_name = stream.stem
        
        log(f"Received subvolume: {subvol_name}", 1, cfg["verbose"])
        return subvol_name
    elif backup_dir:
        # Local mode (original behavior)
        recv_cmd = btrfs_cmd(cfg, "receive", "-f", str(stream), str(backup_dir))

        if cfg.get("dry_run"):
            log(f"[dry-run] {' '.join(recv_cmd)}", 2, cfg["verbose"])
            return stream.stem

        log(f"{' '.join(recv_cmd)}", 2, cfg["verbose"])
        start = datetime.now()

        result = subprocess.run(
            recv_cmd,
            capture_output=True,
            text=True,
            check=False,
        )

        elapsed = (datetime.now() - start).total_seconds()
        log(f"btrfs receive completed in {format_duration(elapsed)}", 1, cfg["verbose"])

        stderr = (result.stderr or "").strip()

        if result.returncode != 0:
            if "already exists" in stderr.lower():
                print(f"Warning: subvolume from '{stream.name}' already exists in "
                      f"{backup_dir} – skipping", file=sys.stderr)
                return None
            print(f"Error receiving '{stream}':\n{stderr}", file=sys.stderr)
            sys.exit(1)

        # Extract subvolume name reported by btrfs
        subvol_name = None
        for line in stderr.splitlines():
            line = line.strip()
            if "At subvol" in line or "Receiving subvol" in line:
                parts = line.split()
                for i, tok in enumerate(parts):
                    if tok in ("subvol", "subvolume") and i + 1 < len(parts):
                        subvol_name = parts[i + 1].strip("'\"")
                        break
            if subvol_name:
                break

        if not subvol_name:
            subvol_name = stream.stem

        log(f"Received subvolume: {subvol_name}", 1, cfg["verbose"])
        return subvol_name
    else:
        print("Error: receive_stream called without backup_dir or remote/remote_dir", file=sys.stderr)
        sys.exit(1)

def archive_name_from_received(name: str) -> str:
    """Extract archive portion from conventional {archive}.{timestamp} name."""
    if "." in name:
        return name.rsplit(".", 1)[0]
    return name

def run_hook(cmd_template: str | None, mapping: dict[str, str], cfg: dict) -> None:
    if not cmd_template:
        log(f"\tNo hook to process", 1, cfg["verbose"])
        return
    cmd = cmd_template
    for key, val in mapping.items():
        cmd = cmd.replace(f"{{{key}}}", val)
    log(f"\tRunning hook: {cmd}", 1, cfg["verbose"])
    if not cfg.get("dry_run"):
        subprocess.run(cmd, shell=True, check=False)

# ---------------------------------------------------------------------------
# Keep Policy- (simple Borg-inspired, ported from btrbu
#  The implementation walks backwards using interval boundaries to help
#  determine what gets kept after a particular keep interval is completed.
#  The hourly boundary is the previous hour, the day is 23:59 of the previous 
#  day, the week is Saturday 11:59:59, the month is the last day of the month
#  the year is 12/31@23:59:59.
# ---------------------------------------------------------------------------
#
# keep policy helpers
_KEEP_REASON = {
    "h": "hourly",
    "d": "daily",
    "w": "weekly",
    "m": "monthly",
    "y": "yearly",
    "1": "newest",
}

def _ts_str(dt: datetime) -> str:
    return dt.strftime("%Y%m%d%H%M")

def _parse_ts_str(ts: str) -> datetime:
    return datetime.strptime(ts, "%Y%m%d%H%M")

def _end_of_hour(dt: datetime) -> datetime:
    return dt.replace(minute=59, second=0, microsecond=0)

def _end_of_day(dt: datetime) -> datetime:
    return dt.replace(hour=23, minute=59, second=0, microsecond=0)

def _prev_hour(ts: str, hrs_cnt: int) -> str:
    t = _parse_ts_str(ts) - timedelta(hours=hrs_cnt)
    return _ts_str(_end_of_hour(t))

def _prev_day(ts: str, days_cnt: int) -> str:
    t = _parse_ts_str(ts) - timedelta(days=days_cnt)
    return _ts_str(_end_of_day(t))

def _prev_week(ts: str, week_cnt: int) -> str:
    """Most recent Saturday at or before ts, then week_cnt weeks further back."""
    t = _parse_ts_str(ts)
    # Saturday = weekday 5 (Mon=0 … Sun=6)
    days_since_sat = (t.weekday() - 5) % 7
    if days_since_sat != 0:
        t = t - timedelta(days=days_since_sat)
    t = t - timedelta(weeks=week_cnt)
    return _ts_str(_end_of_day(t))

def _last_day_of_month(year: int, month: int) -> datetime:
    last = calendar.monthrange(year, month)[1]
    return datetime(year, month, last, 23, 59, 0, 0)

def _prev_month(ts: str, months_cnt: int) -> str:
    """Last day of the target month (23:59), matching btrbu semantics."""
    t = _parse_ts_str(ts)
    last_this = _last_day_of_month(t.year, t.month)

    if months_cnt != 0:
        y, m = t.year, t.month - months_cnt
        while m <= 0:
            m += 12
            y -= 1
        return _ts_str(_last_day_of_month(y, m))

    if t.day != last_this.day:
        # not last day of month → last day of previous month
        if t.month == 1:
            return _ts_str(_last_day_of_month(t.year - 1, 12))
        return _ts_str(_last_day_of_month(t.year, t.month - 1))

    return _ts_str(last_this)

def _prev_year(ts: str, years_cnt: int) -> str:
    t = _parse_ts_str(ts)
    if years_cnt != 0:
        return _ts_str(datetime(t.year - years_cnt, 12, 31, 23, 59, 0, 0))
    if t.month != 12 or t.day != 31:
        return _ts_str(datetime(t.year - 1, 12, 31, 23, 59, 0, 0))
    return _ts_str(datetime(t.year, 12, 31, 23, 59, 0, 0))

_ARCHIVE_TS_RE = re.compile(r"^(.+)\.(\d{12})$")
def iter_archive_items(directory: Path, archive: str):
    """Yield (timestamp_str, path) for exact archive.YYYYMMDDHHMM entries."""
    if not directory.is_dir():
        return
    for p in directory.iterdir():
        if not p.is_dir() and not p.is_symlink():
            # snapshots/backups are subvolumes (dirs); skip plain files
            # remove this guard if you also prune stream files later
            continue
        m = _ARCHIVE_TS_RE.match(p.name)
        if not m:
            continue
        if m.group(1) != archive:
            continue
        ts = m.group(2)
        # validate it's a real datetime
        if parse_ts(p.name) is None:
            continue
        yield ts, p


def iter_archive_items_ssh(remote: str, remote_dir: str, archive: str, cfg: dict):
    """
    Yield (timestamp_str, remote_subvol_path) for exact archive.YYYYMMDDHHMM entries
    on a remote SSH host. Mirrors iter_archive_items but queries via SSH.
    """
    # Build SSH command to list subvolumes
    cmd = build_ssh_cmd(remote, btrfs_cmd(cfg, "subvolume", "list", remote_dir))
    try:
        result = run(cmd, dry_run=False, verbosity=cfg["verbose"],
                     check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError:
        log(f"Failed to list subvolumes on {remote}:{remote_dir}", 3, cfg["verbose"])
        return

    for line in result.stdout.splitlines():
        # Parse: ID 256 gen 1234 top level 5 path lama7.20260831...
        parts = line.split()
        path_idx = -1
        for i, part in enumerate(parts):
            if part == "path" and i + 1 < len(parts):
                path_idx = i + 1
                break
        if path_idx >= 0:
            remote_subvol = parts[path_idx]
            # Match archive pattern
            m = _ARCHIVE_TS_RE.match(remote_subvol)
            if not m:
                continue
            if m.group(1) != archive:
                continue
            ts = m.group(2)
            if parse_ts(remote_subvol) is None:
                continue
            # Yield timestamp and full remote path
            yield ts, f"{remote_dir}/{remote_subvol}"


def apply_keep_policy_ssh(remote: str, remote_dir: str, archive: str, keep: dict, cfg: dict) -> None:
    """
    Apply the given keep policy to backups of an archive on a remote SSH host.
    Mirrors apply_keep_policy but operates via SSH.
    """
    keep_values = [
        keep.get("keep_hourly", 0),
        keep.get("keep_daily", 0),
        keep.get("keep_weekly", 0),
        keep.get("keep_monthly", 0),
        keep.get("keep_yearly", 0),
    ]
    if not any(v > 0 for v in keep_values):
        log(
            f"No keep policy specified for {archive} on SSH remote – skipping pruning",
            1,
            cfg["verbose"],
        )
        return

    log(f"Keep policy for {archive} on SSH remote {remote}:{remote_dir}: {format_keep_policy(keep)}", 1, cfg["verbose"])
    log(f"Applying to {archive} in {remote}:{remote_dir}:", 1, cfg["verbose"])

    items = list(iter_archive_items_ssh(remote, remote_dir, archive, cfg))
    if not items:
        log(f"\tNo prior archives for {archive} found in {remote}:{remote_dir}", 1, cfg["verbose"])
        return

    # ascending timestamp order (btrbu style)
    items.sort(key=lambda x: x[0])
    ts_list = [t for t, _ in items]

    keeps = build_keep_set(ts_list, keep)

    for t, remote_path in items:
        if t in keeps:
            reason = _KEEP_REASON.get(keeps[t], keeps[t])
            log(f"\tKeeping {remote_path} ({reason})", 1, cfg["verbose"])
        else:
            log(f"\tPruning {remote_path}", 1, cfg["verbose"])
            # Build SSH delete command
            delete_cmd = build_ssh_cmd(remote, btrfs_cmd(cfg, "subvolume", "delete", remote_path))
            try:
                run(delete_cmd,
                    dry_run=cfg.get("dry_run", False),
                    verbosity=cfg["verbose"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=True)
            except subprocess.CalledProcessError:
                print(f"Error during prune: `{delete_cmd}`", file=sys.stderr)
                sys.exit(1)

def _get_keeps(
    timestamps: list[str],
    keep_tbl: dict[str, str],
    max_keeps: int,
    ts_start: str,
    interval_label: str,
    interval_f,
) -> str | None:
    """
    Walk timestamps (ascending) from the newest entry <= ts_start backward,
    keeping one per interval.  Returns the oldest timestamp kept in this pass.
    """
    i = len(timestamps) - 1
    while i >= 0 and timestamps[i] > ts_start:
        i -= 1
    if i < 0:
        return None

    keep_cnt = 0
    oldest_keep = None
    while i >= 0:
        keep_tbl[timestamps[i]] = interval_label
        oldest_keep = timestamps[i]
        keep_cnt += 1
        if keep_cnt == max_keeps:
            return oldest_keep
        tsref = interval_f(timestamps[i], 1)
        i -= 1
        while i >= 0 and timestamps[i] > tsref:
            i -= 1
    return oldest_keep

def build_keep_set(ts_list: list[str], keep: dict) -> dict[str, str]:
    """
    Port of btrbu bldKeepList (table-driven interval loop).

    ts_list: sorted ascending list of 'YYYYMMDDHHMM' strings.
    Returns dict { timestamp_str: reason } for timestamps to keep.

    When every keep_* is 0, returns {newest: "d"} for pure-function callers;
    apply_keep_policy skips pruning entirely when all counts are 0.
    """
    counts = {
        "h": keep.get("keep_hourly", 0),
        "d": keep.get("keep_daily", 0),
        "w": keep.get("keep_weekly", 0),
        "m": keep.get("keep_monthly", 0),
        "y": keep.get("keep_yearly", 0),
    }
    total = sum(counts.values())

    if not ts_list:
        return {}

    keeps: dict[str, str] = {}
    newest = ts_list[-1]

    if total == 0:
        keeps[newest] = "d"
        return keeps

    # Always keep the most recent (reason filled by first active interval)
    keeps[newest] = "1"

    if total == 1:
        for label, n in counts.items():
            if n:
                keeps[newest] = label
                break
        return keeps

    # (label, count, step_fn, start_fn(newest, oldest_keep) -> ts_start)
    # start_fn encodes btrbu's per-interval seed boundary.
    intervals = [
        (
            "h",
            counts["h"],
            _prev_hour,
            lambda newest, _old: _prev_hour(newest, 1),
        ),
        (
            "d",
            counts["d"],
            _prev_day,
            lambda newest, _old: _prev_day(newest, 1),
        ),
        (
            "w",
            counts["w"],
            _prev_week,
            lambda newest, old: _prev_week(_prev_day(old or newest, 1), 0),
        ),
        (
            "m",
            counts["m"],
            _prev_month,
            lambda newest, old: _prev_month(_prev_day(old or newest, 1), 0),
        ),
        (
            "y",
            counts["y"],
            _prev_year,
            lambda newest, old: _prev_year(_prev_day(old or newest, 1), 0),
        ),
    ]

    oldest_keep: str | None = None
    prior_total = 0  # sum of counts for shorter intervals already considered

    for label, count, step_fn, start_fn in intervals:
        if count <= 0:
            continue

        if keeps.get(newest) == "1":
            keeps[newest] = label

        # Newest consumes one slot of the shortest active interval only
        n = count
        if prior_total == 0:
            n = count - 1

        if n <= 0:
            oldest_keep = newest
            prior_total += count
            continue

        # Hourly: btrbu always treats newest as the first hourly when hourly > 0
        if label == "h":
            if count == 1:
                oldest_keep = newest
                prior_total += count
                continue
            n = count - 1

        oldest_keep = _get_keeps(
            ts_list,
            keeps,
            n,
            start_fn(newest, oldest_keep),
            label,
            step_fn,
        )
        prior_total += count

    return keeps

def apply_keep_policy(directory: Path, archive: str, keep: dict, cfg: dict) -> None:
    """
    Apply the given keep policy to snapshots or backups of an archive.
    Uses the btrbu algorithm (non-overlapping interval slots from newest backward).
    """
    keep_values = [
        keep.get("keep_hourly", 0),
        keep.get("keep_daily", 0),
        keep.get("keep_weekly", 0),
        keep.get("keep_monthly", 0),
        keep.get("keep_yearly", 0),
    ]
    if not any(v > 0 for v in keep_values):
        log(
            f"No keep policy specified for {archive} – skipping pruning "
            f"(default: leave existing snapshots/backups untouched)",
            1,
            cfg["verbose"],
        )
        return

    if not directory.is_dir():
        log(
            f"Directory '{directory}' does not exist – skipping keep policy for {archive}",
            1,
            cfg["verbose"],
        )
        return

    log(f"Keep policy for {archive}: {format_keep_policy(keep)}", 1, cfg["verbose"])
    log(f"Applying to {archive} in {directory}:", 1, cfg["verbose"])

    items = list(iter_archive_items(directory, archive))
    if not items:
        log(f"\tNo prior archives for {archive} found in {directory}", 1, cfg["verbose"])
        return

    # ascending timestamp order (btrbu style)
    items.sort(key=lambda x: x[0])
    ts_list = [t for t, _ in items]

    keeps = build_keep_set(ts_list, keep)

    for t, p in items:
        if t in keeps:
            reason = _KEEP_REASON.get(keeps[t], keeps[t])
            log(f"\tKeeping {p.name} ({reason})", 1, cfg["verbose"])
        else:
            log(f"\tPruning {p.name}", 1, cfg["verbose"])
            cmd = btrfs_cmd(cfg, "subvolume", "delete", str(p))
            try:
                run(cmd,
                    dry_run=cfg.get("dry_run", False),
                    verbosity=cfg["verbose"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=True)
            except subprocess.CalledProcessError:
                print(f"Error during prune: `{cmd}`", file=sys.stderr)
                sys.exit(1)

#-----------------------------------------------------------------
# Does all archive related actions
#-----------------------------------------------------------------
def process_archive(archive: dict, cfg: dict) -> None:
    """
    Normal processing for a single archive:
    pre-hook → snapshot → post-snapshot-hook → backup → post-backup-hook → keep policy
    If just send_to_file:
    pre-hook -> snapshot -> post-snapshot-hook -> send backup to file -> keep for snapshots
    If just recv_from_file:
    backup receive from file -> post-backup-hook -> keep for backups
    If both send_to and recv_from then same as Normal above except the backup uses a file
    as a staging step.
    Processing for send_to_dir and recv_from_dir uses same processing flow except it will
    handle multiple archives versus a single archive for the file variant 
    """

    # start with setup...
    name = archive["name"]
    subvol = archive["subvolume"]

    # now we can provide some quick logging...
    log(f"=== Processing archive: {name} ({subvol}) ===", 1, cfg["verbose"])

    send_file = archive.get("send_to_file")
    recv_file = archive.get("receive_from_file")
    stage_file = archive.get("stage_file")
    send_dir = archive.get("send_to_dir")
    recv_dir = archive.get("receive_from_dir")
    stage_dir = archive.get("stage_dir")
    snaps_only = archive.get("snaps_only", False)

    # stage_file is sugar for send+receive on the same path, then delete
    if stage_file:
        send_file = stage_file
        recv_file = stage_file

    # stage_dir is sugar for send_to_dir + receive_from_dir on same dir
    staged = False
    if stage_dir and not (send_file or recv_file):
        send_dir = stage_dir
        recv_dir = stage_dir
        staged = True
    elif stage_file:
        staged = True

    # Use per-archive backup_dir if set, otherwise fall back to global
    archive_backup_dir = archive.get("backup_dir")
    backup_dir = Path(archive_backup_dir) if archive_backup_dir else (Path(cfg["backup_dir"]) if cfg.get("backup_dir") else None)
    snap_dir = Path(cfg["snapshot_dir"]) if cfg.get("snapshot_dir") else None
    remote = archive.get("remote")
    remote_dir = archive.get("remote_dir")

    # ----- receive-only (file) -----
    if recv_file and not send_file:
        # Need either backup_dir (local) or remote_dir (SSH)
        if not backup_dir and not (remote and remote_dir):
            print(f"Error: archive '{name}' receive_from_file requires backup_dir or remote_dir (with remote)",
                  file=sys.stderr)
            sys.exit(1)
        if backup_dir:
            chk_btrfs_subvolume(backup_dir, cfg)
        if remote and remote_dir:
            chk_btrfs_subvolume_ssh(remote, remote_dir, cfg)
        p = Path(recv_file)
        if not p.is_file() or not is_btrfs_stream(p, cfg):
            print(f"Error: '{p}' is not a valid btrfs stream file", file=sys.stderr)
            sys.exit(1)
        received = receive_stream(p, backup_dir, cfg, remote, remote_dir)
        if received:
            run_hook(archive.get("post_backup_hook"), {
                "backup": str(backup_dir / received) if backup_dir else f"{remote}:{remote_dir}/{received}",
                "snapshot": "",
                "archive": name,
                "timestamp": timestamp(),
                "snapshotdir": str(snap_dir or ""),
                "backupdir": str(backup_dir) if backup_dir else "",
            }, cfg)
            if backup_dir:
                apply_keep_policy(backup_dir, name, archive["keep"], cfg)
            if remote and remote_dir:
                apply_keep_policy_ssh(remote, remote_dir, name, archive["keep"], cfg)
        return


    # ----- receive-only (dir) -----
    if recv_dir and not send_dir and not send_file:
        # Need either backup_dir (local) or remote_dir (SSH)
        if not backup_dir and not (remote and remote_dir):
            print(f"Error: receive_from_dir requires backup_dir or remote_dir (with remote)", file=sys.stderr)
            sys.exit(1)
        if backup_dir:
            chk_btrfs_subvolume(backup_dir, cfg)
        if remote and remote_dir:
            chk_btrfs_subvolume_ssh(remote, remote_dir, cfg)
        stream = find_newest_stream_for_archive(Path(recv_dir), name, cfg)
        if not stream:
            log(f"No matching stream for archive '{name}' in {recv_dir}", 1, cfg["verbose"])
            return
        log(f"Using stream {stream} for archive {name}", 1, cfg["verbose"])
        received = receive_stream(stream, backup_dir, cfg, remote, remote_dir)
        if received:
            run_hook(archive.get("post_backup_hook"), {
                "backup": str(backup_dir / received) if backup_dir else f"{remote}:{remote_dir}/{received}",
                "snapshot": "",
                "archive": name,
                "timestamp": timestamp(),
                "snapshotdir": str(snap_dir or ""),
                "backupdir": str(backup_dir) if backup_dir else "",
            }, cfg)
            if backup_dir:
                apply_keep_policy(backup_dir, name, archive["keep"], cfg)
            if remote and remote_dir:
                apply_keep_policy_ssh(remote, remote_dir, name, archive["keep"], cfg)
        return

    # ----- paths that create a snapshot -----
    if not snap_dir:
        print("Error: snapshot_dir is required for snapshot/send operations",
              file=sys.stderr)
        sys.exit(1)
    chk_btrfs_subvolume(Path(subvol), cfg)
    chk_btrfs_subvolume(snap_dir, cfg)

    log("Running pre-snapshot hook...", 1, cfg["verbose"])
    run_hook(archive.get("pre_snapshot_hook"), {
        "archive": name, "subvol": subvol, "timestamp": timestamp(),
        "snapshotdir": str(snap_dir),
        "backupdir": str(backup_dir) if backup_dir else "",
    }, cfg)

    log("Creating snapshot...", 1, cfg["verbose"])
    snap = create_snapshot(name, subvol, snap_dir, cfg)

    log("Running post-snapshot hook...", 1, cfg["verbose"])
    run_hook(archive.get("post_snapshot_hook"), {
        "snapshot": str(snap), "archive": name, "timestamp": timestamp(),
        "snapshotdir": str(snap_dir),
        "backupdir": str(backup_dir) if backup_dir else "",
    }, cfg)

    stream_path: Path | None = None

    if send_file:
        stream_path = Path(send_file)
        send_backup_tofile(snap, snap_dir, backup_dir, stream_path, cfg, name, archive)
    elif send_dir:
        chk_is_dir(send_dir, "send-to-dir" if not staged else "stage-dir")
        stream_path = Path(send_dir) / f"{snap.name}.btrfs"
        send_backup_tofile(snap, snap_dir, backup_dir, stream_path, cfg, name, archive)
    # normal piped send|receive
    elif not snaps_only and (backup_dir or (remote and remote_dir)):
        log("Starting backup...", 1, cfg["verbose"])
        # Check remote_dir if configured
        if remote and remote_dir:
            chk_btrfs_subvolume_ssh(remote, remote_dir, cfg)
        if backup_dir:
            chk_btrfs_subvolume(backup_dir, cfg)
        dest = send_backup(snap, snap_dir, backup_dir, cfg, name, archive)
        run_hook(archive.get("post_backup_hook"), {
            "backup": str(dest), "snapshot": str(snap), "archive": name,
            "timestamp": timestamp(), "snapshotdir": str(snap_dir),
            "backupdir": str(backup_dir) if backup_dir else "",
        }, cfg)
        apply_keep_policy(snap_dir, name, archive["keep"], cfg)
        if backup_dir:
            apply_keep_policy(backup_dir, name, archive["keep"], cfg)
        if remote and remote_dir:
            apply_keep_policy_ssh(remote, remote_dir, name, archive["keep"], cfg)
        log(f"Finished archive: {name}\n", 1, cfg["verbose"])
        return
    else:
        # snaps_only or no backup
        apply_keep_policy(snap_dir, name, archive["keep"], cfg)
        log(f"Finished archive: {name}\n", 1, cfg["verbose"])
        return

    # Receive after send-to-file / send-to-dir when receive_* or staging is set
    do_receive = bool(
        stream_path
        and (
            recv_file
            or recv_dir
            or staged
        )
    )
    if do_receive:
        # Need either backup_dir (local) or remote_dir (SSH)
        if not backup_dir and not (remote and remote_dir):
            print("Error: receive requires backup_dir or remote_dir (with remote)", file=sys.stderr)
            sys.exit(1)
        if backup_dir:
            chk_btrfs_subvolume(backup_dir, cfg)
        
        # Check remote_dir if configured
        if remote and remote_dir:
            chk_btrfs_subvolume_ssh(remote, remote_dir, cfg)

        # Note that by this point, recv_file and recv_dir should NOT both be set. We took
        # care with configuration rules that should prevent that combination.  In fact, 
        # from out little logic assignment above, only 1 of recv_file, recv_dir or staged
        # should be set by the time this code is executed...
        # if stage_dir or stage_file was set, then use the stream_path from the send
        if staged:
            recv_path = stream_path
        # check for receive_from_file...
        elif recv_file:
            recv_path = Path(recv_file)
        # check for receive_from_dir...
        elif recv_dir:
            # use stream_path from the send if recv_dir and send_dir are the same
            if recv_dir == send_dir:
                recv_path = stream_path  
            else:  # different recv_dir and send_dir...
                # search the recv_dir for the most recent stream file for this archive
                recv_path = find_newest_stream_for_archive(Path(recv_dir), name, cfg)
                if not recv_path:
                    log(f"No matching stream for archive '{name}' in {recv_dir}", 1, cfg["verbose"])
                    return
        else:
            # some combination we didn't anticipate go us to this point...
            print("Should never get here...", file=sys.stderr)
            sys.exit(1)

        # Non-staged: receive_from_file may differ from send_to_file
        if recv_file and send_file and not staged:
            recv_path = Path(recv_file)

        received = receive_stream(recv_path, backup_dir, cfg, remote, remote_dir)
        if received:
            run_hook(archive.get("post_backup_hook"), {
                "backup": str(backup_dir / received) if backup_dir else f"{remote}:{remote_dir}/{received}",
                "snapshot": str(snap),
                "archive": name,
                "timestamp": timestamp(),
                "snapshotdir": str(snap_dir),
                "backupdir": str(backup_dir) if backup_dir else "",
            }, cfg)
            if backup_dir:
                apply_keep_policy(backup_dir, name, archive["keep"], cfg)
            if remote and remote_dir:
                apply_keep_policy_ssh(remote, remote_dir, name, archive["keep"], cfg)

        if staged and stream_path is not None:
            remove_stage_file(stream_path, cfg)

    apply_keep_policy(snap_dir, name, archive["keep"], cfg)
    log(f"Finished archive: {name}\n", 1, cfg["verbose"])

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> int:

    parser = argparse.ArgumentParser(
        description="btrfs snapshot & backup tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  bubtrsnap --snapshot-dir=/pool/snapshots --backup-dir=/backup home=/home
  bubtrsnap --config=~/.config/bubtrsnap.toml
  bubtrsnap -v --snaps-only root=/
  bubtrsnap --send-to-file /dirfor/streamdata/file/ maildir=/home/user/Maildir
        """
    )

    # Global options
    parser.add_argument(
        "--config",
        type=Path,
        help="Path to TOML configuration file (default: ~/.config/bubtrsnap.toml)"
    )
    parser.add_argument(
        "--snapshot-dir",
        type=str,
        help="Directory where read-only snapshots will be created"
    )
    parser.add_argument(
        "--backup-dir",
        type=str,
        help="Directory where backups will be sent via btrfs send/receive"
    )
    parser.add_argument(
        "--snaps-only",
        action="store_true",
        help="Only create snapshots; skip the backup step"
    )
    parser.add_argument("--send-to-file", type=str, metavar="FILE",
        help="Send stream to FILE (archive-specific). Exactly one archive required. "
             "Mutually exclusive with --snaps-only and the *-dir options.")
    parser.add_argument("--receive-from-file", type=str, metavar="FILE",
        help="Receive stream from FILE (archive-specific). Exactly one archive required. "
             "If used with --send-to-file, both must name the same file.")
    parser.add_argument("--send-to-dir", type=str, metavar="DIR",
        help="Write per-archive streams into DIR as {archive}.{timestamp}.btrfs. "
             "Global; applies to CLI archives or all config archives.")
    parser.add_argument("--receive-from-dir", type=str, metavar="DIR",
        help="Receive newest matching stream for each archive from DIR.")
    parser.add_argument(
        "--stage-file", type=str, metavar="FILE",
        help="Stage via FILE: btrfs send -f FILE then receive -f FILE, then delete FILE. "
             "Exactly one archive. Mutually exclusive with other send/receive/stage options "
             "and with --snaps-only.",
    )
    parser.add_argument(
        "--stage-dir", type=str, metavar="DIR",
        help="Stage via DIR: write {archive}.{timestamp}.btrfs, receive it, then delete it. "
             "Applies to listed or all archives. Mutually exclusive with other send/receive/stage "
             "options and with --snaps-only.",
    )
    parser.add_argument(
        "--remote", type=str, metavar="USER@HOST",
        help="SSH remote in user@host format for sending backups over SSH. "
             "Can be set globally or per-archive in config file."
    )
    parser.add_argument(
        "--remote-dir", type=str, metavar="DIR",
        help="Target directory on the SSH remote for receiving backups. "
             "Can be set globally or per-archive in config file."
    )
    parser.add_argument(
        "--sudo",
        action="store_true",
        help="Run btrfs commands with 'sudo -n'"
    )

    # Keep policy (CLI keeps are all-or-nothing)
    parser.add_argument("--keep-hourly", type=int, metavar="N", help="Number of hourly snapshots/backups to retain")
    parser.add_argument("--keep-daily", type=int, metavar="N", help="Number of daily snapshots/backups to retain")
    parser.add_argument("--keep-weekly", type=int, metavar="N", help="Number of weekly snapshots/backups to retain")
    parser.add_argument("--keep-monthly", type=int, metavar="N", help="Number of monthly snapshots/backups to retain")
    parser.add_argument("--keep-yearly", type=int, metavar="N", help="Number of yearly snapshots/backups to retain")

    # Verbosity
    parser.add_argument(
        "-v", "--verbose",
        type=int,
        nargs="?",
        const=1,
        default=0,
        metavar="LEVEL",
        help="Verbosity level: 0=quiet (default), 1=progress, 2=commands. "
             "-v alone means level 1, --verbose 2 means level 2"
    )
    parser.add_argument(
        "--debug",
        action="store_true",
        help="Enable debug output (highest level)"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be done without making changes (implies -vv)"
    )
    parser.add_argument(
        "archives",
        nargs="*",
        metavar="ARCHIVE[=SUBVOLUME]",
        help="Archives to process. Can be just the archive name (looked up in the "
             "config file) or name=/path/to/subvolume. "
             "If none are given, all archives from the config file are processed."
    )

    # parse them args...
    args = parser.parse_args()

    # various pre-checks for certain options and option combinations
    # snaps-only and either of the send-to-*, recv-from-* or stage-* don't make
    # sense so we'll flag that...
    if args.snaps_only and (
        args.send_to_file or args.receive_from_file or args.stage_file
        or args.send_to_dir or args.receive_from_dir or args.stage_dir
    ):
        print(
            "Error: --snaps-only is mutually exclusive with send/receive/stage "
            "file and directory options",
            file=sys.stderr,
        )
        return 1

    if (args.send_to_file or args.receive_from_file or args.stage_file) and (
        args.send_to_dir or args.receive_from_dir or args.stage_dir
    ):
        print(
            "Error: cannot mix file options with directory options",
            file=sys.stderr,
        )
        return 1

    if args.stage_file and (
        args.send_to_file or args.receive_from_file
        or args.send_to_dir or args.receive_from_dir or args.stage_dir
    ):
        print("Error: --stage-file is mutually exclusive with other send/receive/stage options",
              file=sys.stderr)
        return 1
    if args.stage_dir and (
        args.send_to_file or args.receive_from_file or args.stage_file
        or args.send_to_dir or args.receive_from_dir
    ):
        print("Error: --stage-dir is mutually exclusive with other send/receive/stage options",
              file=sys.stderr)
        return 1

    # don't mix file specific send/recv options with dir versions of the options
    if (args.send_to_file or args.receive_from_file) and (args.send_to_dir or args.receive_from_dir):
        print("Error: cannot mix --send-to-file/--receive-from-file with "
              "--send-to-dir/--receive-from-dir", file=sys.stderr)
        return 1

    # remote and remote_dir must be used together
    if (args.remote and not args.remote_dir) or (args.remote_dir and not args.remote):
        print("Error: --remote and --remote-dir must be specified together", file=sys.stderr)
        return 1

    # Verbosity handling 
    verbosity = args.verbose
    if args.debug:
        verbosity = 3
    if args.dry_run:
        verbosity = max(verbosity, 2)

    config_path = args.config or Path.home() / ".config" / "bubtrsnap.toml"

    try:
        global_cfg, archives = load_and_resolve_archives(
            args, config_path if config_path.exists() else None
        )
    except SystemExit:
        return 1

    global_cfg["verbose"] = verbosity
    global_cfg["dry_run"] = args.dry_run

    # see if we're doing a recv only operation....
    receive_only = all(
        (a.get("receive_from_file") or a.get("receive_from_dir"))
        and not a.get("send_to_file")
        and not a.get("send_to_dir")
        and not a.get("stage_file")
        and not a.get("stage_dir")
        and not a.get("snaps_only")
        for a in archives
    ) if archives else False

    # if not doing just a recv, then taking snapshots and snapshot_dir is needed
    if not receive_only and not global_cfg.get("snapshot_dir"):
        print("--snapshot-dir is required", file=sys.stderr)
        return 1

    if not archives:
        print("No archives to process.", file=sys.stderr)
        return 1

    # Process each archive fully
    for archive in archives:
        try:
            process_archive(archive, global_cfg)
        except Exception as e:
            log(f"Error processing {archive['name']}: {e}", 1, global_cfg["verbose"])
            return 1

    log("All archives processed.", 1, global_cfg["verbose"])
    return 0    

if __name__ == "__main__":
    sys.exit(main())
